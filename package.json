{
  "name": "opencode-computer-use-win",
  "version": "0.1.3",
  "description": "OpenCode Windows computer-use plugin adapted from dsh-computer-use-win: session-aware desktop/browser control, progress overlay and full settings extension",
  "type": "module",
  "bin": {
    "wcu-mcp": "mcp/server.mjs",
    "opencode-cu": "opencode/cli.mjs"
  },
  "main": "opencode/plugin.mjs",
  "files": [
    "mcp/server.mjs",
    "mcp/dsh-plugin.mjs",
    "mcp/client.js",
    "mcp/settings.mjs",
    "mcp/takeover.mjs",
    "mcp/activity.mjs",
    "mcp/progress-summary.mjs",
    "mcp/overlay-strings.mjs",
    "mcp/browser.mjs",
    "mcp/browser-bidi.mjs",
    "mcp/browser-bidi-dom.mjs",
    "scripts/windows-uia.ps1",
    "scripts/windows-takeover.ps1",
    "scripts/windows-takeover.cs",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "opencode/",
    "dist/",
    "mcp/request-context.mjs"
  ],
  "exports": {
    ".": "./opencode/plugin.mjs",
    "./client": "./mcp/client.js",
    "./mcp/server.mjs": "./mcp/server.mjs",
    "./mcp/dsh-plugin.mjs": "./mcp/dsh-plugin.mjs",
    "./package.json": "./package.json",
    "./*": "./*",
    "./tui": "./opencode/tui.mjs",
    "./dsh": "./mcp/dsh-plugin.mjs"
  },
  "scripts": {
    "selftest": "node mcp/server.mjs --self-test",
    "mcp-test": "node test/mcp-test.mjs",
    "profile-resolution": "node test/profile-resolution.mjs",
    "test": "npm run test:opencode",
    "e2e": "node test/notepad-e2e.mjs",
    "build": "node opencode/build.mjs",
    "test:opencode": "node --test test/opencode-*.test.mjs",
    "test:upstream": "node test/run-tests.mjs",
    "prepack": "npm run build",
    "test:ui": "node test/run-opencode-ui.mjs",
    "test:host": "node test/run-opencode-host.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "computer-use",
    "windows",
    "uia",
    "desktop-automation"
  ],
  "author": "xshu-hub",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/client": "2.3.1",
    "electron": "44.0.0",
    "js-yaml": "4.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.2 || >=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xshu-hub/opencode-computer-use-win.git"
  },
  "bugs": {
    "url": "https://github.com/xshu-hub/opencode-computer-use-win/issues"
  },
  "homepage": "https://github.com/xshu-hub/opencode-computer-use-win#readme"
}
